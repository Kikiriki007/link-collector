# Copy to .env (never commit the real one) and fill in both values.
#
# Get them at https://my.telegram.org - log in with your own Telegram account (not the bot),
# go to "API development tools", and create an app. Any name/platform works, this is just your
# personal API credential pair, separate from the bot token in config.json.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
